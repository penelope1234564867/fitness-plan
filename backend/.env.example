# ====================================
# Fitness Plan Backend — 环境变量示例
# 复制此文件为 .env 并填入实际值
# Render 部署时在 Dashboard 设置这些变量
# ====================================

# LLM 配置（DeepSeek 或其他 OpenAI 兼容 API）
LLM_MODEL_ID=deepseek-v4-flash
FAST_LLM_MODEL_ID=deepseek-v4-flash
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_TIMEOUT=60

# 服务器配置（Render 会自动设置 PORT 覆盖此值）
HOST=0.0.0.0
PORT=8000

# 日志级别
LOG_LEVEL=INFO
